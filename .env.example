# Copy to .env for local dev, or set these in Render → Environment.

# Client (VITE_ prefix — embedded in browser bundle at build time)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only (optional — not used by client code today)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Render sets PORT automatically; optional locally:
# PORT=3000
# NODE_ENV=production
